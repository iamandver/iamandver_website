# Keep the asset library local, except for site fonts and their licenses.
/src/assets/**
!/src/assets/fonts/
!/src/assets/fonts/Fira_Mono/
!/src/assets/fonts/Fira_Mono/FiraMono-Regular.ttf
!/src/assets/fonts/Fira_Mono/FiraMono-Medium.ttf
!/src/assets/fonts/Fira_Mono/FiraMono-Bold.ttf
!/src/assets/fonts/Fira_Mono/OFL.txt
!/src/assets/fonts/oldschool_pc_font_pack_v2.2_web/
!/src/assets/fonts/oldschool_pc_font_pack_v2.2_web/LICENSE.TXT
!/src/assets/fonts/oldschool_pc_font_pack_v2.2_web/woff - Web (webfonts)/
!/src/assets/fonts/oldschool_pc_font_pack_v2.2_web/woff - Web (webfonts)/WebPlus_IBM_VGA_8x16.woff

